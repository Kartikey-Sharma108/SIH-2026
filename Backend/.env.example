# ============================================================================
# AI Security Gateway — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# ============================================================================

# Supabase local Postgres (default for `npx supabase start`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Hugging Face Inference API key (for Meta Prompt Guard model)
HUGGINGFACE_API_KEY=hf_your_key_here

# LLM API key (Claude or Gemini)
LLM_API_KEY=your_llm_api_key_here

# LLM provider: "claude" or "gemini"
LLM_PROVIDER=gemini

# Risk threshold — prompts scoring above this are blocked (0–100)
RISK_THRESHOLD=70

# Server port
PORT=3001
